            <dd>
                @Html.ActionLink("SỬA", "Edit", new { id = Model.ProductID }
           , new { @class = "btn btn-primary btn-sm" }) |
                @Html.ActionLink("QUAY LẠI DANH SÁCH", "Index", null, new { @class = "btn btn-primary btn-sm" }) )
            </dd>
</body>
</html>
