@model _23dh171095_MyStore.Models.Product

@{
    Layout = null;
}
<h2 class=" bg-success container-fluid">chi tiết sản phẩm</h2>

<div class =" table bg-info container-fluid">
        <dl class="dl-horizontal">
            <dt> Tên sản phẩm</dt>
            <dt>@Html.DisplayFor(model => model.ProductName)</dt>
