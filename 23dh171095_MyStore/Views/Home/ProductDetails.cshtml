@model _23dh171095_MyStore.Models.ViewModel.ProductDetailsVM

@{
    ViewBag.Title = "ProductDetails";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<head>
    <style>
        .pro {
            padding: 50px 10px 50px 10px;
            background-color: ghostwhite;
        }

        .pro-section {
            background-color: white;
            border: 1px groove #ffffff;
            border-radius: 10px;
            /*
            padding: 5px;
            margin: 10px;
            */
        }

            .pro-section img {
                max-height: 250px;
                max-width: 200px;
                padding: 5px;
            }

        .pro-price {
            font-weight: bolder;
            font-size: larger;
            color: red;
        }

        .pro-sale {
            font-weight: lighter;
        }
    </style>
</head>
<div class="container-fluid pro">
    <div class="div-horizontal">
        <div class="col-md-3 pro-section">
            <img src="@Model.product.ProductImage" />
        </div>
        @*khối ở giữa*@
        <div class="col-md-5 pro-section">
            @*phần thông tin sản phẩm *@
            <div>
                <h4>
                    <strong>@Html.DisplayFor(model => model.product.ProductName)</strong>
                    Đã bán:&nbsp;@Model.product.OrderDetails.Count()
                </h4>
                <p class="pro-price">@Model.product.ProductPrice.ToString("C")</p>
                <p>Từ sách:&nbsp;@Model.product.Category.CategoryName</p>
                <hr />
                <h5><strong>Mô tả</strong></h5>
                <p>@Model.product.ProductDescription</p>
                <hr />
            </div>
            @*khối relatedproduct*@
            <div>@Html.Partial("_PVRelatedProduct", Model)</div>
        </div>

        <div class="col-md-3 pro-section">
            @using (Html.BeginForm("ProductDetails", "Home", FormMethod.Get))
            {
                <div class="form-group">
                    <h4><strong>Số lượng</strong></h4>
                    <p>
                        @Html.TextBoxFor(model => model.quantity, new
                        {
                            @class = "form-control",
                            @type = "number",
                            @min = 1
                        })
                    </p>
                </div>

                <h4><strong>Tạm tính</strong></h4>
                <p>@Model.estimatedValue.ToString("N0")</p>

                <p>
                    @Html.ActionLink("Thêm vào giỏ hàng", "AddToCart", "Cart",
                        new { id = Model.product.ProductID, quantity = Model.quantity },
                        new { @class = "btn btn-info" })
                </p>
            }
            <hr />
        </div>
        @*khối TopProduct*@
        <div>@Html.Partial("_PV_TopProduct", Model)</div>
    </div>
</div>