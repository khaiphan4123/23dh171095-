@model _23dh171095_MyStore.Models.Category

@{
    ViewBag.Title = "Edit";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success">Cập nhật danh mục</h2>


@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    
<div class="form-horizontal for">
    <hr />
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.CategoryID)
    @*nhung Partial View vao form cha*@
    @Html.Partial("PVCreateEditCategory", Model)
</div>
}



@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
