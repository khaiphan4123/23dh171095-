@model IEnumerable<_23dh171095_MyStore.Models.Category>

@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success">Danh Muc San Pham </h2>


<table class= "table bg-info col-lg-12 col-md-6 ">
    <tr>
        <th class= " bg-success col-md-4">
            @*@Html.DisplayNameFor(model => model.CategoryName)*@
            TEN DANH MUC
        </th>
        <th class="bg-success col-md-2"></th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.CategoryName)
        </td>
        <td>
            @Html.ActionLink("Sua", "Edit", new { id = item.CategoryID }, new { @class = "btn btn-primary" })
            @Html.ActionLink("Xoa", "Delete", new { id = item.CategoryID }, new { @class = "btn btn-primary" })
        </td>
    </tr>
}

</table>
<p>
    @Html.ActionLink("Them moi", "Create", null, new { @class = "btn btn-primary btn-sm" })
</p>
