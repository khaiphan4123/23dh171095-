@model _23dh171095_MyStore.Models.Product
<head>
    <style>
        img {
            height: 250px;
            max-width: 250px;
        }
    </style>
    <div class="container-fluid">
        <dl class="dl-horizontal">
            <div class="col-md-3">
                <img src="  @Html.DisplayFor(model => model.ProductImage)" />
            </div>
            <div class="col-md-9">
                <dl>
                    <dt> Tên sản phẩm </dt>
                    <dd>@Html.DisplayFor(model => model.ProductName)</dd>

                    <dt>Đơn giá</dt>
                    <dt> @Html.DisplayNameFor(model => model.ProductPrice) </dt>

                    <dt> Hình ảnh</dt>
                    <dd> @Html.DisplayFor(model => model.ProductImage) </dd>

                    <dt> Mô tả </dt>
                    <dd> @Html.DisplayFor(model => model.ProductDescription)</dd>

                    <dt> Danh mục </dt>
                    <dd>@Html.DisplayFor(model => model.Category.CategoryName)</dd>
            </div>

